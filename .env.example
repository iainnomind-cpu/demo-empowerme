# ── Sitio ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp de Empowerme (formato internacional, sin +)
NEXT_PUBLIC_WHATSAPP=523300000000

# ── Supabase ─────────────────────────────────────────────
# Sin estas variables el sitio corre en "modo demo" con datos en memoria.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Correos que reciben rol de administrador al iniciar sesión (separados por coma)
ADMIN_EMAILS=

# ── Pagos (Stripe, modo prueba) ──────────────────────────
# Sin llave se usa un pago simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notificaciones ───────────────────────────────────────
# Sin llaves los mensajes se guardan en Admin › Envíos como "simulado".
RESEND_API_KEY=
EMAIL_FROM="Empowerme <hola@empowerme.mx>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
